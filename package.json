    "@remotion/layout-utils": "4.0.533",
    "@remotion/zod-types": "4.0.533",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.533",
    "simple-icons": "15.22.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
